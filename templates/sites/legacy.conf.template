server {
    server_name {{ (parseUrl .Env.WEB_LEGACY_PLAY).Hostname }};

    location ^~ /__wand/ruffle/ {
        alias /opt/wand/ruffle/;
        add_header X-Content-Type-Options nosniff always;
    }

    location ~ ^/__wand/ws/(login|blizzard|glaciar|avalanche|yeti)$ {
        # Compare the full public origin, including scheme and optional port.
        if ($http_origin != "{{ (parseUrl .Env.WEB_LEGACY_PLAY).Scheme }}://{{ (parseUrl .Env.WEB_LEGACY_PLAY).Host }}") {
            return 403;
        }
        resolver 127.0.0.11 valid=10s;
        set $socket_backend websocket:8080;
        proxy_pass http://$socket_backend/?token=$1;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Origin $http_origin;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Root assets (/css, /scripts, /images) are referenced by the original HTML.
    root /usr/share/nginx/legacy/play;
    location / {
        index index.html index.htm;
    }
    {{ if (parseUrl .Env.WEB_LEGACY_PLAY).Path }}
    location {{ (parseUrl .Env.WEB_LEGACY_PLAY).Path }}/ {
        alias /usr/share/nginx/legacy/play/;
        index index.html index.htm;
    }
    location = {{ (parseUrl .Env.WEB_LEGACY_PLAY).Path }} {
        return 301 {{ (parseUrl .Env.WEB_LEGACY_PLAY).Path }}/;
    }
    {{ end }}

    # boots.swf requests its first loader at the media origin's /play/v2/.
    location ^~ /play/v2/ {
        alias /usr/share/nginx/legacy/media/play/v2/;
    }
    {{ if eq (parseUrl .Env.WEB_LEGACY_PLAY).Host (parseUrl .Env.WEB_LEGACY_MEDIA).Host }}
    location {{ (parseUrl .Env.WEB_LEGACY_MEDIA).Path }}/ {
        alias /usr/share/nginx/legacy/media/;
    }
    {{ end }}

    location /create_account/create_account.php {
        proxy_pass http://dash:3000/create/legacy/;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~ ^/penguin/activate/(.*) {
        proxy_pass http://dash:3000/activate/legacy/$1;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /manager {
        proxy_pass http://dash:3000/manager;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

}

{{ if ne (parseUrl .Env.WEB_LEGACY_PLAY).Host (parseUrl .Env.WEB_LEGACY_MEDIA).Host }}
server {
    server_name {{ (parseUrl .Env.WEB_LEGACY_MEDIA).Hostname }};
    add_header Access-Control-Allow-Origin "{{ (parseUrl .Env.WEB_LEGACY_PLAY).Scheme }}://{{ (parseUrl .Env.WEB_LEGACY_PLAY).Host }}" always;
    add_header Vary Origin always;

    # XMLSocket client modules can resolve this absolute path on the media host.
    location = /create_account/create_account.php {
        proxy_pass http://dash:3000/create/legacy/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    root /usr/share/nginx/legacy/media;
    location / {
        index index.html index.htm;
    }
    {{ if (parseUrl .Env.WEB_LEGACY_MEDIA).Path }}
    location {{ (parseUrl .Env.WEB_LEGACY_MEDIA).Path }}/ {
        alias /usr/share/nginx/legacy/media/;
    }
    {{ end }}
}
{{ end }}
